{
  "name": "@aotoki/slidev-theme-terraforming",
  "type": "module",
  "version": "0.7.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elct9620/slidev-theme-terraforming.git"
  },
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "files": [
    "CHANGELOG.md",
    "assets",
    "components",
    "composables",
    "layouts",
    "setup",
    "slide-bottom.vue",
    "styles"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:deck": "vitest run --project deck",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@slidev/types": "^52.19.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@slidev/cli": "^52.19.1",
    "@slidev/client": "^52.19.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "playwright-chromium": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "canvasWidth": 1920,
      "aspectRatio": "16/9",
      "transition": "tf-fade",
      "fonts": {
        "mono": "JetBrains Mono"
      }
    }
  }
}
