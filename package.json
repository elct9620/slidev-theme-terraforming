{
  "name": "@aotoki/slidev-theme-terraforming",
  "version": "0.5.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elct9620/slidev-theme-terraforming.git"
  },
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.18.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.18.0",
    "@slidev/client": "^52.18.0",
    "playwright-chromium": "^1.61.1",
    "vue": "^3.5.40"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "canvasWidth": 1920,
      "aspectRatio": "16/9",
      "transition": "view-transition",
      "fonts": {
        "mono": "JetBrains Mono"
      }
    }
  }
}
